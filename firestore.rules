rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    // Public readers worldwide can view live posts and videos
    match /posts/{postId} {
      allow read: if true;
      allow write: if true;
    }

    match /settings/{settingsId} {
      allow read: if true;
      allow write: if true;
    }

    match /public_users/{userId} {
      allow read, write: if true;
    }

    match /access_requests/{requestId} {
      allow read, write: if true;
    }

    match /test/{testId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
